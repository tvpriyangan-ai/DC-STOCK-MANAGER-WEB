# Copy this file to ".env" and fill in your real MySQL Workbench details.
# This matches the credentials your Tkinter app used in database.py

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=dc_stock_v2

# Port the API server itself will run on
PORT=4000

# Secret used to sign login tokens. Generate a real random value with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Keep this out of git (it already is, via .env) and never reuse the example value.
JWT_SECRET=change_this_to_a_long_random_value
